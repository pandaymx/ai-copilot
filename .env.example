# ===== AI-Copilot 环境变量示例 =====
# 复制为 .env 后按需修改：cp .env.example .env

# ---- 基础设施 ----
POSTGRES_DB=ai_copilot
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai
OLLAMA_HOST_PORT=11435
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ---- 模型供应商 API Key（请勿提交真实密钥）----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---- 记忆与限流 ----
# 对话后端令牌桶限流开关（true=开启，保护上游 API 配额；Redis 不可用时自动降级放行）。
# 前端 API 代理另有 IP 滑动窗口限流（120 次/分钟），但为粗粒度整体限流，建议生产开启后端限流。
AI_MEMORY_RATELIMIT_ENABLED=true
# 限流窗口内最大请求数（令牌桶容量）
AI_MEMORY_RATELIMIT_CAPACITY=20
# 限流窗口时长（秒）
AI_MEMORY_RATELIMIT_REFILL=60

# ---- 跨域安全 (CORS) ----
# 生产环境 strict 模式下建议显式收敛为具体的 Origin 域名列表，避免通配符 * 风险
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8084
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-User-Id,X-Requested-With

# ---- Caddy 网关（生产部署反向代理 + 自动 TLS）----
# 对外服务域名；需将 A 记录指向本机，且 80/443 公网可达（HTTP 挑战）。
CADDY_DOMAIN=ai.home.ppmblszdp.top

# basic_auth 的 bcrypt 哈希，由以下命令生成（替换单引号内明文密码）：
#   docker run --rm caddy:2-alpine caddy hash-password '你的密码'
# 必须配置非空哈希值！若留空，docker compose 中的 Caddy 容器在启动检查时会立即报错退出（exit 1），以防止生产环境无认证裸奔。
CADDY_BASIC_AUTH_HASH=
