# Server Configuration
PORT=8084
SERVER_PORT=8084

# Spring AI - DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Spring AI - OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o

# Spring AI - Google GenAI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Spring AI - Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Spring AI - Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =====================================================================
# 统一抽象层 - 二等公民供应商（均为 your_xxx_here 占位时自动跳过注册）
# =====================================================================

# 通义千问 (OpenAI 兼容)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 百度千帆 (OpenAI 兼容)
QIANFAN_API_KEY=your_qianfan_api_key_here
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# 智谱 GLM (OpenAI 兼容)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 全局默认 provider / model（缺省回落；前端不带 provider/model 时使用）
AI_DEFAULT_PROVIDER=deepseek
AI_DEFAULT_MODEL=deepseek-chat

# CORS 跨域域名收敛配置（生产环境建议配置为具体域名，逗号分隔，如 http://localhost:3000,https://app.yourdomain.com）
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
